+func phase0QualificationKind(content string) string {
+	command, _, _ := strings.Cut(strings.TrimSpace(content), " ")
+	switch strings.ToLower(command) {
+	case "/status":
+		return "status"
+	case "/echo":
+		return "echo"
+	default:
+		return "rejected"
+	}
+}
+
+func phase0QualificationResponse(
+	enabled bool,
+	privateChat bool,
+	allowed bool,
+	content string,
+	uptime time.Duration,
+) (handled bool, response string) {
+	if !enabled {
+		return false, ""
+	}
+	if !privateChat {
+		return true, "This qualification bot accepts private chats only."
+	}
+	if !allowed {
+		return true, "Access denied."
+	}
+
+	content = strings.TrimSpace(content)
+	command, arg, _ := strings.Cut(content, " ")
+	switch strings.ToLower(command) {
+	case "/status":
+		seconds := int64(uptime / time.Second)
+		if seconds < 0 {
+			seconds = 0
+		}
+		return true, fmt.Sprintf("phase0_status=ok uptime_seconds=%d", seconds)
+	case "/echo":
+		arg = strings.TrimSpace(arg)
+		if arg == "" {
+			return true, "Usage: /echo <text>"
+		}
+		const maxEchoRunes = 512
+		runes := []rune(arg)
+		if len(runes) > maxEchoRunes {
+			runes = runes[:maxEchoRunes]
+		}
+		return true, "echo: " + string(runes)
+	default:
+		return false, ""
+	}
+}
