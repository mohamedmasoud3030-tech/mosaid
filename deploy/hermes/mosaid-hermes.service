[Unit]
Description=Mosaid Hermes Agent Gateway
Documentation=https://github.com/mohamedmasoud3030-tech/mosaid
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/opt/mosaid/current
ConditionPathExists=/var/lib/mosaid/hermes/.env
ConditionPathExists=/var/lib/mosaid/hermes/config.yaml

[Service]
Type=simple
User=mosaid
Group=mosaid
WorkingDirectory=/var/lib/mosaid/workspaces
Environment=HERMES_HOME=/var/lib/mosaid/hermes
EnvironmentFile=/var/lib/mosaid/hermes/.env
ExecStartPre=/opt/mosaid/bin/preflight-hermes
ExecStart=/opt/mosaid/current/.venv/bin/hermes gateway
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/opt/mosaid
ReadOnlyPaths=/var/lib/mosaid/hermes/SOUL.md
ReadOnlyPaths=/var/lib/mosaid/hermes/.no-bundled-skills
ReadOnlyPaths=/var/lib/mosaid/workspaces/.hermes.md
ReadWritePaths=/var/lib/mosaid

LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mosaid-hermes

[Install]
WantedBy=multi-user.target
