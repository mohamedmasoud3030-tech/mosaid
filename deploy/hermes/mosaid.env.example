# Install as $HERMES_HOME/.env with mode 0600 on the Oracle instance.
# Replace placeholders locally on the server. Never commit the populated file.

HERMES_HOME=/var/lib/mosaid/hermes

# Pinned upstream source metadata used by deployment scripts.
HERMES_REPOSITORY=https://github.com/NousResearch/hermes-agent.git
HERMES_REF=b8ceba97ed0b2bf0255cc5c8c61c9110a026cda4

# Owner-only Telegram gate.
TELEGRAM_BOT_TOKEN=REPLACE_ON_SERVER
TELEGRAM_ALLOWED_USERS=REPLACE_WITH_NUMERIC_OWNER_ID

# Provider-neutral OpenAI-compatible endpoint.
MODEL_NAME=REPLACE_WITH_MODEL_ID
MODEL_BASE_URL=REPLACE_WITH_VERIFIED_FREE_OR_SELF_HOSTED_ENDPOINT
OPENAI_API_KEY=REPLACE_ON_SERVER_OR_LOCAL_DUMMY_VALUE

# Mosaid deployment controls. These are enforced by deployment validation and
# product policy; Hermes itself does not interpret every MOSAID_* variable.
MOSAID_BILLING_MODE=free_only
MOSAID_MAX_SPEND_USD=0
MOSAID_ALLOW_PAID_FALLBACK=false
MOSAID_UNKNOWN_COST_POLICY=deny
MOSAID_PRIVATE_CHAT_ONLY=true
MOSAID_UNATTENDED_UPDATE=false
MOSAID_PUBLIC_DASHBOARD=false

# Oracle deployment metadata; non-secret.
OCI_REGION=ap-singapore-1
OCI_BILLING_STATUS=unknown
OCI_INSTANCE_SHAPE=REPLACE_AFTER_INSTANCE_REVIEW
