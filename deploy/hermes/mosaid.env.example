# Copy to /etc/mosaid/mosaid.env on the Oracle instance.
# Never commit the populated file.

MOSAID_ENV=production
MOSAID_HOME=/opt/mosaid
MOSAID_DATA_DIR=/var/lib/mosaid
MOSAID_PRODUCT_DIR=/opt/mosaid/product

# Pin before deployment. Do not use a floating branch in production.
HERMES_REPOSITORY=https://github.com/NousResearch/hermes-agent.git
HERMES_REF=REPLACE_WITH_REVIEWED_COMMIT_SHA

# Telegram owner-only first gate.
MOSAID_OWNER_TELEGRAM_ID=REPLACE_WITH_NUMERIC_OWNER_ID
TELEGRAM_BOT_TOKEN_FILE=/etc/mosaid/telegram.token

# Provider-neutral model endpoint. Keep the key in the referenced file.
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=REPLACE_WITH_VERIFIED_FREE_OR_SELF_HOSTED_ENDPOINT
MODEL_NAME=REPLACE_WITH_MODEL_ID
MODEL_API_KEY_FILE=/etc/mosaid/model.key

# Cost policy.
MOSAID_BILLING_MODE=free_only
MOSAID_MAX_SPEND_USD=0
MOSAID_ALLOW_PAID_FALLBACK=false
MOSAID_UNKNOWN_COST_POLICY=deny

# Safety defaults.
MOSAID_PRIVATE_CHAT_ONLY=true
MOSAID_EXTERNAL_SKILLS_AUTO_ENABLE=false
MOSAID_SKILL_SELF_ACTIVATION=false
MOSAID_REQUIRE_APPROVAL_FOR_EXTERNAL_ACTIONS=true
MOSAID_UNATTENDED_UPDATE=false
MOSAID_PUBLIC_DASHBOARD=false

# Oracle deployment metadata; non-secret.
OCI_REGION=ap-singapore-1
OCI_BILLING_STATUS=unknown
OCI_INSTANCE_SHAPE=REPLACE_AFTER_INSTANCE_REVIEW
