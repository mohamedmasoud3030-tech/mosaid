{
  "id": "social-publishing",
  "version": "1.0.0",
  "description": "Prepare, preview, and publish through the official Meta Graph API; publishing requires content-bound approval.",
  "type": "builtin",
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "prepare",
          "preview",
          "publish"
        ]
      },
      "draft_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "account_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "artifact_id": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64
      },
      "asset_hash": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64
      },
      "caption": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2200
      },
      "caption_hash": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64
      },
      "publish_at": {
        "type": "string",
        "minLength": 20,
        "maxLength": 64
      },
      "creation_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "max_attempts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    },
    "required": [
      "operation"
    ],
    "additionalProperties": false
  },
  "outputs": [
    {
      "name": "draft",
      "description": "Validated publishing draft or preview.",
      "schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "required_tools": [
    "instagram.prepare",
    "instagram.preview",
    "instagram.publish"
  ],
  "required_permissions": [
    "read",
    "write",
    "publish"
  ],
  "required_secrets": [
    "META_ACCESS_TOKEN"
  ],
  "allowed_networks": [
    "graph.facebook.com"
  ],
  "timeout_seconds": 300,
  "approval_policy": "bound_publish",
  "compatibility": {
    "min_core": "0.1.0",
    "os": [
      "linux",
      "android"
    ],
    "arch": [
      "amd64",
      "arm64"
    ]
  },
  "integrity_hash": "sha256:c39ce85ada463e3c59115c5f32ad0468d82840bac474da2f35fe24438e43879e"
}
