# ---- إعدادات Vercel == لوحة env (عدّل الحقول بمنزلك) ----

# 1) Supabase (من لوحة Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2) مفتاح الموديل — الافتراضي Gemini (مجاني): ⭐ ابدأ به
#   احصل على مفتاح مجاني من https://aistudio.google.com/apikey
#   هذا هو المُزوّد الوحيد بطبقة مجانية دائمة بدون بطاقة.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

#   (اختياري) لو حابب OpenAI بدل Gemini — وعدّل MODEL_PROVIDER
#OPENAI_API_KEY=
#MODEL_PROVIDER=openai

#   (اختياري) لو حابب Anthropic
#ANTHROPIC_API_KEY=
#MODEL_PROVIDER=anthropic

# 3) رمز دخول الوكيل — أجعل كلمة مرورك! في أي فعل بالخادم
AGENT_ACCESS_CODE=
